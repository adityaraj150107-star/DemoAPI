{
  "info": {
    "_postman_id": "bc60648b-3584-451b-9ba9-0c3f94a6443a",
    "name": "DemoAPI Task Manager — JWT and Roles",
    "description": "Set credentials in a private Postman environment before running. Tests the teacher/student task flow and authentication errors.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "teacher_email", "value": "" },
    { "key": "teacher_password", "value": "" },
    { "key": "student_email", "value": "" },
    { "key": "student_password", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "teacher_id", "value": "" },
    { "key": "student_id", "value": "" },
    { "key": "task_id", "value": "" },
    { "key": "previous_refresh_token", "value": "" },
    { "key": "revoked_access_token", "value": "" }
  ],
  "item": [
    {
      "name": "Teacher login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{teacher_email}}\",\"password\":\"{{teacher_password}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Teacher login succeeds', function () { pm.response.to.have.status(200); });",
            "const data = pm.response.json();",
            "pm.environment.set('access_token', data.access_token);",
            "pm.environment.set('refresh_token', data.refresh_token);",
            "pm.environment.set('teacher_id', data.user.id);"
          ]
        }
      }]
    },
