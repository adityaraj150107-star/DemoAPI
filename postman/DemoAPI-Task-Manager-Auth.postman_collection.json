    {
      "name": "Student updates task status and notes",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"in progress\",\"work_notes\":\"Started the exercise.\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/v3/tasks/{{task_id}}"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Student updates own task', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('in progress'); });"
          ]
        }
      }]
    },
    {
      "name": "Student refreshes and rotates tokens",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.environment.set('previous_refresh_token', pm.environment.get('refresh_token'));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refresh token rotates', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.environment.set('access_token', data.access_token);",
              "pm.environment.set('refresh_token', data.refresh_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"refresh_token\":\"{{refresh_token}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/auth/refresh"
      }
    },
    {
      "name": "Old refresh token is rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"refresh_token\":\"{{previous_refresh_token}}\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/auth/refresh"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": ["pm.test('Previously rotated token is rejected', function () { pm.response.to.have.status(401); });"]
        }
      }]
    },
